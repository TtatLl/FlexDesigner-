# 统一换行符：仓库里一律存 LF，检出时按平台转换。
* text=auto

# 这些文件在 macOS 上直接执行（sh / JXA），必须是 LF，否则会报 \r 之类的错。
*.sh   text eol=lf
*.jxa  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.vue  text eol=lf
*.md   text eol=lf

# Windows 上用的脚本保留 CRLF。
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 图片等二进制文件不做任何转换。
*.png  binary
*.jpg  binary
*.gif  binary
