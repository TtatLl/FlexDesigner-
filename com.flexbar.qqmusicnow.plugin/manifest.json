{
  "name": "QQMusicNow",
  "uuid": "com.flexbar.qqmusicnow",
  "version": "1.0.0",
  "author": "Your Name",
  "entry": "backend/plugin.cjs",
  "description": "QQ Music lyrics, now playing and playback control for Flexbar",
  "repo": "https://github.com/your-name/Flexbar-QQMusicNow",
  "sdk": {
    "version": "1.0.0"
  },
  "software": {
    "minimumVersion": "1.0.0"
  },
  "os": [
    {
      "platform": "mac",
      "minimumVersion": "10.15"
    },
    {
      "platform": "windows",
      "minimumVersion": "10"
    }
  ],
  "device": [
    {
      "name": "flexbar",
      "version": "1.0.0"
    }
  ],
  "configPage": "configPage",
  "keyLibrary": {
    "title": "$PluginName",
    "style": {
      "icon": "mdi mdi-music-note-eighth"
    },
    "children": [
      {
        "title": "$NowPlaying.Title",
        "tip": "$NowPlaying.Tip",
        "cid": "com.flexbar.qqmusicnow.nowplaying",
        "config": {
          "keyType": "default",
          "clickable": false,
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-music",
          "width": 600,
          "bgColor": "#000000",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000",
          "flags": [
            "disable-bg",
            "disable-fg",
            "disable-icon-sel",
            "disable-layout-sel"
          ]
        },
        "data": {
          "showCover": true,
          "showTitle": true,
          "showArtist": true,
          "showAlbum": true,
          "showProgress": true,
          "showTime": true,
          "useDynamicBackground": true,
          "backgroundColor": "#000000",
          "primaryTextColor": "#FFFFFF",
          "secondaryTextColor": "#D6D6D6",
          "progressFillColor": "#31C27C",
          "progressBgColor": "#404040"
        }
      },
      {
        "title": "$Lyric.Title",
        "tip": "$Lyric.Tip",
        "cid": "com.flexbar.qqmusicnow.lyric",
        "config": {
          "keyType": "default",
          "clickable": true,
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-music-note",
          "width": 480,
          "bgColor": "#000000",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000",
          "flags": [
            "disable-bg",
            "disable-fg",
            "disable-icon-sel",
            "disable-layout-sel"
          ]
        },
        "data": {
          "showDualLine": true,
          "showTranslation": true,
          "highlightWord": true,
          "useDynamicBackground": false,
          "backgroundColor": "#1A1A1A",
          "primaryAlign": "center",
          "primaryFontSize": 22,
          "singleLineFontSize": 28,
          "primaryColor": "#FFFFFF",
          "highlightColor": "#31C27C",
          "primaryPaddingTop": 5,
          "secondaryAlign": "center",
          "secondaryFontSize": 17,
          "secondaryColor": "#D6D6D6",
          "secondaryPaddingTop": 35,
          "paddingHorizontal": 10
        }
      },
      {
        "title": "$PlayPause.Title",
        "tip": "$PlayPause.Tip",
        "cid": "com.flexbar.qqmusicnow.playpause",
        "config": {
          "keyType": "multiState",
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-play",
          "width": 240,
          "bgColor": "#000000",
          "fgColor": "#FFFFFF",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000",
          "multiStyle": [
            {
              "icon": "mdi mdi-play"
            },
            {
              "icon": "mdi mdi-pause"
            }
          ]
        },
        "data": {
          "states": [
            {
              "icon": "mdi mdi-play"
            },
            {
              "icon": "mdi mdi-pause"
            }
          ]
        }
      },
      {
        "title": "$Previous.Title",
        "tip": "$Previous.Tip",
        "cid": "com.flexbar.qqmusicnow.previous",
        "config": {
          "keyType": "default",
          "clickable": true,
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-skip-previous",
          "width": 240,
          "bgColor": "#000000",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000"
        },
        "data": {}
      },
      {
        "title": "$Next.Title",
        "tip": "$Next.Tip",
        "cid": "com.flexbar.qqmusicnow.next",
        "config": {
          "keyType": "default",
          "clickable": true,
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-skip-next",
          "width": 240,
          "bgColor": "#000000",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000"
        },
        "data": {}
      },
      {
        "title": "$Source.Title",
        "tip": "$Source.Tip",
        "cid": "com.flexbar.qqmusicnow.source",
        "config": {
          "keyType": "default",
          "clickable": true,
          "platform": [
            "windows",
            "mac"
          ]
        },
        "style": {
          "icon": "mdi mdi-information-outline",
          "width": 240,
          "bgColor": "#000000",
          "borderStyle": "none",
          "borderWidth": 0,
          "borderColor": "#000000"
        },
        "data": {
          "showProviderName": true,
          "showLyricSource": true
        }
      }
    ]
  },
  "local": {
