          "ProbeRunning": "Testing...",
          "Reload": "Reload Lyrics",
          "OpenQqMusic": "Open QQ Music",
          "Result": "Result",
          "NoResult": "No QQ Music session detected",
          "Save": "Save",
          "Saved": "Saved",
          "CanvasAvailable": "Canvas renderer",
          "CanvasMissing": "Canvas renderer missing - text fallback mode",
          "Yes": "available",
          "No": "not available"
